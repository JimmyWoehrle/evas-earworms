---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.name | xmlEscape }}</title><link>{{ '/' | absoluteUrl(site.url) | xmlEscape }}</link><description>{{ site.description | xmlEscape }}</description><language>{{ site.language }}</language>
    <atom:link href="{{ '/feed.xml' | absoluteUrl(site.url) | xmlEscape }}" rel="self" type="application/rss+xml" />
    {% for post in collections.publishedPosts %}<item><title>{{ post.data.title | xmlEscape }}</title><link>{{ post.url | absoluteUrl(site.url) | xmlEscape }}</link><guid>{{ post.url | absoluteUrl(site.url) | xmlEscape }}</guid><pubDate>{{ post.date.toUTCString() }}</pubDate><description>{{ post.data.description | xmlEscape }}</description></item>{% endfor %}
  </channel>
</rss>
